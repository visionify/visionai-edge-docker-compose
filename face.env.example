# visionai-face (face recognition sidecar) configuration.
#   cp face.env.example face.env      # face.env is gitignored (*.env); never commit the token
# Every setting is VISIONAI_FACE_<FIELD>. Full reference: visionai-face-recognition/docs/CONFIGURATION.md.
# The results URL (inference's /v1/face/results) is set in docker-compose*.yml; override it with
# FACE_RESULTS_URL in the root .env if inference runs elsewhere. FACE_TAG in the root .env picks the image tag.

# Required: the visionai-app edge API and the site's API token (POST /api/sites/<uuid>/tokens).
VISIONAI_FACE_APP_API_URL=https://<app host>/api/v1
VISIONAI_FACE_APP_API_TOKEN=<site API token>

# Optional overrides (defaults shown)
# VISIONAI_FACE_EXECUTION_PROVIDER=auto     # auto | cuda | cpu   (cpu leaves the GPU to inference)
# VISIONAI_FACE_CPU_THREADS=0               # 0 = one per core
# VISIONAI_FACE_MATCH_THRESHOLD=0.40
# VISIONAI_FACE_MATCH_MARGIN=0.08
# VISIONAI_FACE_DETECTOR_SCORE_MIN=0.50
# VISIONAI_FACE_MIN_INTEROCULAR_PX=20
# VISIONAI_FACE_LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR

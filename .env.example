# ============================================================================
# Motherson edge .env - HYBRID profile
# Dashboard, control-plane and event media live in Visionify cloud.
# Only inference + Triton run on this box.
#
# Copy this file to .env and fill every line marked  >>> FILL
# ============================================================================
ENVIRONMENT=PROD
DEBUG=0

# ===== DOCKER HUB ACCESS TOKEN (read-only, provided by Visionify) ===========
# >>> FILL: the installer uses this token to pull the private images. No password needed.
DOCKERHUB_TOKEN=REPLACE_WITH_DOCKERHUB_TOKEN

# ===== IMAGE TAGS (leave as-is unless Visionify says otherwise) =============
VISIONAI_TAG=latest
MODELS_TAG=latest
TRITON_TAG=25.09-py3

# ===== CLOUD CONTROL PLANE (Visionify dashboard) ============================
# >>> FILL: cloud dashboard API URL and the Motherson site API token
#           (Dashboard -> Settings -> Sites -> <site> -> API token)
VISIONAI_API_ENDPOINT=https://app.visionify.ai/api
VISIONAI_API_TOKEN=REPLACE_WITH_SITE_TOKEN
VISIONAI_API_BACKEND=v2
RUN_SCENARIOS=1
OFFLINE_MODE=0
SUPPORT_ALL_SITES_FROM_COMPANY=0

# ===== CLOUD EVENT STORAGE (Azure Blob) =====================================
# >>> FILL: the Azure Blob connection string provided by Visionify
AZURE_BLOB_STORAGE=1
EVENTS_AZURE_BLOB_CONTAINER=visionai
EVENTS_AZURE_BLOB_CONNECTION_STRING=REPLACE_WITH_AZURE_BLOB_CONNECTION_STRING
USE_STORAGE_BROKER=1

# ===== TRITON (local, inside compose network) ===============================
TRITON_HTTP_URL=http://visionai-triton:8000
TRITON_GRPC_URL=http://visionai-triton:8001
NUM_INSTANCES=1

# ===== LIVE / RTMP (disabled) ===============================================
ENABLE_LIVE_INFERENCE=0
DEFAULT_LIVE_INFERENCE=0
RTMP_SERVER_URL=rtmp://127.0.0.1:1935/live

# ===== VISION-LLM SECOND-PASS REVIEW (cloud Azure Foundry, optional) ========
# >>> FILL if Visionify enables second-pass review for this site, else leave 0
ENABLE_VIT=0
MAKE_PHI3_VISION_REVIEW=0
#AZURE_FOUNDRY_API_ENDPOINT=
#AZURE_FOUNDRY_API_TOKEN=

# ===== FIREBASE REALTIME DB (cloud, provided by Visionify) ==================
# >>> FILL: paste the Firebase service-account values provided by Visionify
#FIREBASE_DATABASE_URL=
#FIREBASE_PROJECT_ID=
#FIREBASE_PRIVATE_KEY_ID=
#FIREBASE_PRIVATE_KEY=
#FIREBASE_CLIENT_EMAIL=
#FIREBASE_CLIENT_ID=
#FIREBASE_CLIENT_X509_CERT_URL=

# ===== REMOTE DECOMMISSION (watchdog) =======================================
# Regenerating or deleting this site's API token in the cloud dashboard makes the
# watchdog remove the whole deployment from this box after the grace period below.
DECOMMISSION_ENABLED=1
DECOMMISSION_AFTER_MINUTES=120
WATCHDOG_INTERVAL_SECONDS=300
# Local data folder (camera configs, cache). Default: ~/.visionai
#VISIONAI_DATA_DIR=

# ===== GSTREAMER / GPU DECODE ===============================================
USE_GSTREAMER=1
GPU_DECODER=1
GST_RTSP_FORCE_TCP=1
GST_RTSP_SIMPLE_H264=0
USE_SIMPLE_RTSP=1
GST_DEBUG=0

# ===== MEMORY MONITOR =======================================================
MEMORY_MONITOR=1
MEMORY_MONITOR_INTERVAL=300
